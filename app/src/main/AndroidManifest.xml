<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE scanning on API 29 requires both Bluetooth permissions and fine location. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Keeps stale-signal detection running during CPU sleep while monitoring. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Opens the alarm page over the lock screen so Silence is directly reachable. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- The app is offline by design, so INTERNET is intentionally not requested. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:name=".ThermometerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Separate task: closing the alarm returns to the lock screen or prior app. -->
        <activity
            android:name=".ui.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <!-- Type "location" lets a user-started service keep scanning while the
             app is backgrounded on Android 10 without ACCESS_BACKGROUND_LOCATION.
             Screen-off delivery still requires physical verification. -->
        <service
            android:name=".service.MonitoringService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
