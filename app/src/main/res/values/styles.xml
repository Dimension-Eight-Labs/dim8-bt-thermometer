<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One high-contrast dark theme: docs/DESIGN.md prefers one verified theme over two.
         Typography is the platform sans-serif (Roboto on the Pixel XL). -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:colorPrimaryDark">@color/background</item>
        <item name="android:colorAccent">@color/vfd_primary</item>
        <item name="android:colorControlHighlight">@color/vfd_glow</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_body</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:alertDialogTheme">@style/Dim8Dialog</item>
    </style>

    <style name="Dim8Dialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorBackground">@color/surface_raised</item>
        <item name="android:colorAccent">@color/vfd_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_body</item>
    </style>

    <style name="Dim8Button" parent="android:Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Dim8Button.Secondary">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Dim8Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/background</item>
    </style>

    <style name="Dim8Button.Silence">
        <item name="android:background">@drawable/btn_silence</item>
        <item name="android:textColor">@color/alarm_background</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/vfd_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
