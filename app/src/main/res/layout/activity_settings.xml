<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <ImageButton
            android:id="@+id/settings_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:shadowColor="@color/vfd_glow"
            android:shadowRadius="8"
            android:text="@string/settings"
            android:textColor="@color/vfd_bright"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <LinearLayout style="@style/SettingsCard" android:layout_marginTop="0dp">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/thermometer" />

                <TextView
                    android:id="@+id/settings_device"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/settings_change_device"
                    style="@style/Dim8Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/change_thermometer" />
            </LinearLayout>

            <include
                android:id="@+id/settings_probe_1"
                layout="@layout/probe_settings" />

            <include
                android:id="@+id/settings_probe_2"
                layout="@layout/probe_settings" />

            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/display" />

                <Switch
                    android:id="@+id/settings_fahrenheit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:saveEnabled="false"
                    android:text="@string/use_fahrenheit"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <include android:id="@+id/settings_color_band" layout="@layout/settings_field" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/alerts" />

                <Switch
                    android:id="@+id/settings_signal_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:saveEnabled="false"
                    android:text="@string/signal_warning"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/settings_notifications"
                    style="@style/Dim8Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/notification_settings" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Outside the scroll view, and above the keyboard through adjustResize. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/settings_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:textColor="@color/alarm_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/settings_save"
            style="@style/Dim8Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
