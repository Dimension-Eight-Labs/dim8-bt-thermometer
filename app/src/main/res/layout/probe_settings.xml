<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SettingsCard">

    <TextView
        android:id="@+id/group_title"
        style="@style/SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/probe_in_use"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/probe_in_use_help"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/field_in_use"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/probe_in_use"
            android:saveEnabled="false" />
    </LinearLayout>

    <include android:id="@+id/field_target" layout="@layout/settings_field" />
    <include android:id="@+id/field_low" layout="@layout/settings_field" />
    <include android:id="@+id/field_high" layout="@layout/settings_field" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/advanced"
        android:textColor="@color/vfd_dim"
        android:textSize="12sp"
        android:textStyle="bold" />

    <include android:id="@+id/field_hysteresis" layout="@layout/settings_field" />

    <TextView
        android:id="@+id/group_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/alarm_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
