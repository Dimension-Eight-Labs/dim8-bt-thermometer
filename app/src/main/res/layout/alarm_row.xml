<?xml version="1.0" encoding="utf-8"?>
<!-- Equal weights keep up to three alarms, and every Silence button, on one Pixel XL
     screen. AlarmActivity enlarges the reading and button when fewer rows are shown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_weight="1"
    android:background="@drawable/bg_card_alarm"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="assertive"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_temperature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="44sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_limit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <!-- Oversized for wet or occupied hands at the grill. -->
    <Button
        android:id="@+id/alarm_silence"
        style="@style/Dim8Button.Silence"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:textSize="20sp" />
</LinearLayout>
