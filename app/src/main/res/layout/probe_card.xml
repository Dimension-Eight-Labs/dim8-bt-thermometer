<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/probe_root"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@drawable/bg_card"
    android:minHeight="208dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/probe_name"
            style="@style/SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/probe_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_state_chip"
            android:maxLines="1"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Fixed height with auto-size keeps the card stable and hot readings on one line. -->
            <TextView
                android:id="@+id/probe_temperature"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:autoSizeMaxTextSize="66sp"
                android:autoSizeMinTextSize="32sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/probe_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_body"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="108dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <include android:id="@+id/limit_target" layout="@layout/limit_row" />
            <include android:id="@+id/limit_low" layout="@layout/limit_row" />
            <include android:id="@+id/limit_high" layout="@layout/limit_row" />
        </LinearLayout>
    </LinearLayout>

    <!-- The graph yields height to Silence during an audible alarm, so the card and the
         controls below it do not shift and the newest readings are never covered. -->
    <com.dim8labs.btthermometer.ui.HistoryGraphView
        android:id="@+id/probe_graph"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:minHeight="52dp" />

    <Button
        android:id="@+id/probe_silence"
        style="@style/Dim8Button.Silence"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        android:visibility="gone" />
</LinearLayout>
