<?xml version="1.0" encoding="utf-8"?>
<!-- The label stays beside the value, so it remains visible when the field is filled. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/field_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/field_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- saveEnabled is off because these ids repeat across probe groups. Android's
         automatic state restore would otherwise copy one probe's values into the other. -->
    <EditText
        android:id="@+id/field_value"
        android:layout_width="92dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_field"
        android:gravity="center_vertical|end"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:saveEnabled="false"
        android:selectAllOnFocus="true"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/field_unit"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />
</LinearLayout>
